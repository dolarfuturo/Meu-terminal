def get_global_vars():
    return {
        "ajuste": 5.4850, "ref": 5.4720, "v_min": 0.9950, "v_jus": 1.0000, "v_max": 1.0050,
        "dif_arb": 0.00, "vol_imp": 0.00, "notas_mural": "SISTEMA OPERACIONAL ATIVO"
    }
v_global = get_global_vars()

# 2. CSS BLOOMBERG PURE DATA (SEM GRÁFICOS)
st.markdown("""
